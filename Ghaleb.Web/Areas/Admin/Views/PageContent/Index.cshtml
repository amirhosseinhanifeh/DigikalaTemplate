@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AuthoringTagHelpers
@model IEnumerable<ALO.DomainClasses.Entity.Content.tbl_PageContent>
@{
    ViewData["Title"] = "لیست صفحات";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


            @(
                Html
                .Grid(Model)
                .Build(columns =>
                {
                    columns.Add(model => model.Title);
                    columns.Add(model => $"<a class='btn btn-warning' href=\"Edit/{model.Id}\">ویرایش</a> <a class='btn btn-dark' href=\"/PageBuilder?id={model.Id}\">صفحه ساز</a>").Encoded(false);
                })
                .Filterable()
                .Sortable()
                .Empty("موردی یافت نشد")
                .Pageable(pager =>
                {
            pager.PageSizes = new Dictionary<Int32, String> { { 0, "All" }, { 5, "5" }, { 10, "10" }, { 15, "15" }, { 20, "20" } };
            pager.ShowPageSizes = true;
            pager.PagesToDisplay = 5;
            pager.CurrentPage = 1;
            pager.RowsPerPage = 2;
                })
                )
