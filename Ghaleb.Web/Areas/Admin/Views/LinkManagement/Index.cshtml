@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AuthoringTagHelpers
@model IEnumerable<ALO.DomainClasses.Entity.LinkManagement.tbl_LinkManagement>
@{
    ViewData["Title"] = "مدیریت لینک ها";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<p>
    <a type="button" class="btn btn-primary" asp-route-GroupLinkManagementId="@ViewBag.Id" asp-action="Create">افزودن</a>
</p>
@(
        Html
        .Grid(Model)
        .Build(columns =>
        {
            columns.Add(model => model.Id);
            columns.Add(model => model.Title);
            columns.Add(model => model.Abstract);
            columns.Add().Encoded(false).RenderedAs(h => Html.ActionLink("ویرایش", "Create", new { Id = h.Id }, new { @class = "btn btn-dark" }));
        })
        .Filterable()
        .Sortable()
        .Empty("موردی یافت نشد")
        .Pageable(pager =>
        {
            pager.PageSizes = new Dictionary<Int32, String> { { 0, "All" }, { 5, "5" }, { 10, "10" }, { 15, "15" }, { 20, "20" } };
            pager.ShowPageSizes = true;
            pager.PagesToDisplay = 5;
            pager.CurrentPage = 1;
            pager.RowsPerPage = 2;
        })
        )
