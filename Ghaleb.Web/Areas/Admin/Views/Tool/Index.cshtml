@model IQueryable<ALO.DomainClasses.Entity.Content.tbl_Tools>
@{
    ViewData["Title"] = "لیست ابزار ها";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    
}
<p>
    <a type="button" asp-action="Create" class="btn btn-primary">افزودن</a>
</p>

@(
Html
        .Grid(Model)
        .Build(columns =>
        {
            columns.Add(model => model.Name);
            columns.Add(model => $"<a class='btn btn-dark' href=\"/{ViewContext.RouteData.Values["area"]}/{ViewContext.RouteData.Values["controller"]}/Create/{model.Id}\">ویرایش</a>").Encoded(false);
        })
        .Filterable()
        .Sortable()
        .Empty("موردی یافت نشد")
    .Pageable(pager =>
    {
        pager.PageSizes = new Dictionary<Int32, String> { { 0, "All" }, { 5, "5" }, { 10, "10" }, { 15, "15" }, { 20, "20" } };
        pager.ShowPageSizes = true;
        pager.PagesToDisplay = 5;
        pager.CurrentPage = 1;
        pager.RowsPerPage = 2;
    })
                    )