@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AuthoringTagHelpers
@model IEnumerable<ALO.DomainClasses.Entity.Product.tbl_MainProductCategory>
@{
    ViewData["Title"] = "لیست دسته بندی ها";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<p>
    <a type="button" asp-action="Create" class="btn btn-primary">افزودن</a>
</p>



@(
        Html
        .Grid(Model)
        .Build(columns =>
        {
            columns.Add(model => model.Name);
            
            columns.Add(model => $"<a class='btn btn-primary' href=\"/{ViewContext.RouteData.Values["area"]}/ProductCategory/Index?mainId={model.Id}\">دسته وسط ({model.ProductCategories.Count(x => x.IsDelete == false)})</a> <a class='btn btn-dark' href=\"/{ViewContext.RouteData.Values["area"]}/{ViewContext.RouteData.Values["controller"]}/Create/{model.Id}\">ویرایش</a> <a class='btn btn-danger' href=\"/{ViewContext.RouteData.Values["area"]}/{ViewContext.RouteData.Values["controller"]}/Delete/{model.Id}\">حذف</a>").Encoded(false);
        })
        .Filterable()
        .Sortable()
        .Empty("موردی یافت نشد")
        .Pageable(pager =>
        {
            pager.PageSizes = new Dictionary<Int32, String> { { 0, "All" }, { 5, "5" }, { 10, "10" }, { 15, "15" }, { 20, "20" } };
            pager.ShowPageSizes = true;
            pager.PagesToDisplay = 5;
            pager.CurrentPage = 1;
            pager.RowsPerPage = 2;
        })
        )