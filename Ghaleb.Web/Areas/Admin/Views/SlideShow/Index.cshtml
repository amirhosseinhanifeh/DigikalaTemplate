@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AuthoringTagHelpers
@model IEnumerable<ALO.DomainClasses.Entity.Content.tbl_SlideShow>
@{
    ViewData["Title"] = "لیست تصاویر اسلاید شو";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="row align-items-center">
    <div class="col text-right">
        <a type="button" asp-action="Create" class="btn btn-primary">افزودن</a>
    </div>
</div>


@(
        Html
        .Grid(Model)
        .Build(columns =>
        {
            columns.Add(model => model.Title);
            columns.Add(model => model.Link);
            columns.Add(model => model.LinkText);
            columns.Add(model => $"<a class='btn btn-dark' href=\"/{ViewContext.RouteData.Values["area"]}/{ViewContext.RouteData.Values["controller"]}/Edit/{model.Id}\">ویرایش</a> <a class='btn btn-danger' href=\"/{ViewContext.RouteData.Values["area"]}/{ViewContext.RouteData.Values["controller"]}/Delete/{model.Id}\">حذف</a>").Encoded(false);
        })
        .Filterable()
        .Sortable()
        .Empty("موردی یافت نشد")
        .Pageable(pager =>
        {
            pager.PageSizes = new Dictionary<Int32, String> { { 0, "All" }, { 5, "5" }, { 10, "10" }, { 15, "15" }, { 20, "20" } };
            pager.ShowPageSizes = true;
            pager.PagesToDisplay = 5;
            pager.CurrentPage = 1;
            pager.RowsPerPage = 2;
        })
        )