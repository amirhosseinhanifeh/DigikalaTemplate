@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AuthoringTagHelpers
@model IEnumerable<ALO.DomainClasses.Entity.Cache.tbl_Cache>

@{
    ViewData["Title"] = "مدیریت کش سیستم";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<p>
    <a asp-action="Create" class="btn btn-primary">افزودن</a>
</p>

@(
        Html
        .Grid(Model)
        .Build(columns =>
        {
            columns.Add(model => model.Id).Titled("Id");
            columns.Add(model => model.CacheName).Titled("CacheName");
            columns.Add(model => model.ModifiedDate).Titled("ModifiedDate");
            columns.Add().Encoded(false).RenderedAs(h => Html.ActionLink("پاک کردن", "Remove", new { cacheName = h.CacheName }, new { @class = "btn btn-dark" }));
        })
        .Filterable()
        .Sortable()
        .Empty("موردی یافت نشد")
        .Pageable(pager =>
        {
            pager.PageSizes = new Dictionary<Int32, String> { { 0, "All" }, { 5, "5" }, { 10, "10" }, { 15, "15" }, { 20, "20" } };
            pager.ShowPageSizes = true;
            pager.PagesToDisplay = 5;
            pager.CurrentPage = 1;
            pager.RowsPerPage = 3;
        })
        )

