@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AuthoringTagHelpers
@model IEnumerable<ALO.ViewModels.BlogCategory.GetBlogCategoryListForAdminDTO>
@{
    ViewData["Title"] = "لیست محصولات";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


<p>
    <a type="button" asp-action="Create" class="btn btn-primary">افزودن</a>
</p>


@(
        Html
        .Grid(Model)
        .Build(columns =>
        {
            columns.Add(model => model.Row);
            columns.Add(model => model.Title);
            columns.Add(model => model.Status);

    columns.Add().Encoded(false).RenderedAs(

 @<text>
    <a class="btn btn-primary" asp-area="Admin" asp-action="Index" asp-controller="Blog" asp-route-blogCategoryId="@item.Id">پست ها</a>
    <button class="btn btn-dark" area="Admin" id="@item.Id" action="Edit" controller="BlogCategory" data-toggle="modal" data-target="#exampleModal" onclick="EditModal(this)">ویرایش</button>
    <a class="btn btn-danger" asp-action="Delete" asp-area="Admin" asp-controller="BlogCategory" asp-route-id="@item.Id">حذف</a>
</text>
   );
        })
        .Filterable()
        .Sortable()
        .Empty("موردی یافت نشد")
        .Pageable(pager =>
        {
            pager.PageSizes = new Dictionary<Int32, String> { { 0, "All" }, { 5, "5" }, { 10, "10" }, { 15, "15" }, { 20, "20" } };
            pager.ShowPageSizes = true;
            pager.PagesToDisplay = 5;
            pager.CurrentPage = 1;
            pager.RowsPerPage = 2;
        })
        )