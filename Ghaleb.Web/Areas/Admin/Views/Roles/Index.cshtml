@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AuthoringTagHelpers
@using ALO.Common.Utilities.ConvertDt
@model IEnumerable<ALO.DomainClasses.Entity.Account.tbl_Role>
@{
    ViewData["Title"] = "لیست دسته بندی ها";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-xl-12">
        <div class="">
            <a asp-action="Create" class="btn btn-primary">افزودن نقش</a>
            <div class="table-responsive mt-3">
                <table class="table align-items-center table-flush">
                    <thead>
                        <tr>
                            <th>نام </th>
                            <th>تعداد اعضا</th>
                            <th>آخرین بروز رسانی</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.RoleName</td>
                                <td>@item.Users.Count()</td>
                                <td>@item.ModifiedDate.ConvertToPesainDate()</td>
                                <td>
                                    <a class="btn btn-dark" asp-route-roleid="@item.Id" asp-action="Index" asp-controller="Users">اعضا</a>
                                    <a class="btn btn-success" asp-route-id="@item.Id" asp-action="SendSms">ارسال پیامک</a>
                                    <a class="btn btn-warning" asp-route-id="@item.Id" asp-action="Create">ویرایش</a>
                                    <a class="btn btn-danger" asp-route-id="@item.Id" asp-action="Delete">حذف</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>