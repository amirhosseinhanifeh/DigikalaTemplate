@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, AuthoringTagHelpers
@model IEnumerable<ALO.DomainClasses.Entity.Account.tbl_Users>
@{
    ViewData["Title"] = "لیست کاربران";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<p>
    <form method="get" class="row">
        <div class="col-3">
            <input class="form-control" name="fullName" value="@ViewBag.FullName" placeholder="نام و نام خانوادگی" />
        </div>
        <div class="col-3">
            <input class="form-control" name="mobile" value="@ViewBag.Mobile" placeholder="موبایل" />
        </div>
        <div class="col-3">
            <input class="form-control" name="email" value="@ViewBag.Email" placeholder="ایمیل" />
        </div>
        <div class="form-group col-3">
            <select asp-items="ViewBag.Roles" name="roleId" class="form-control">
                <option value="">نقش</option>
            </select>
        </div>
        <div class="col-1">
            <button type="submit" class="btn btn-dark col-12">جستجو</button>
        </div>
        <div class="col-1">
            <button type="reset" class="btn btn-danger col-12">پاک</button>
        </div>
    </form>
</p>
@(
Html
        .Grid(Model)
        .Build(columns =>
        {
            columns.Add(model => model.Id);
            columns.Add(model => model.Profile.FirstName);
            columns.Add(model => model.Profile.LastName);
            columns.Add(model => model.Mobile);
            columns.Add(model => model.Email);
            columns.Add(model => model.Orders.Count(h => h.OrderStateHistories.Any(f => f.OrderState == ALO.DomainClasses.Entity.Order.OrderState.PAYED))).Titled("تعداد سفارش");
            columns.Add().Encoded(false).RenderedAs(

            @<text>
    <a class="btn btn-dark" asp-route-userId="@item.Id" asp-controller="Order" asp-action="Index">سفارشات</a>
@*     <a class="btn btn-dark" asp-route-id="@item.Id" asp-action="Menues">دسترسی ها</a> *@
    <a class="btn btn-warning" asp-route-id="@item.Id" asp-action="Addresses">آدرس ها</a>
    <a class="btn btn-success" asp-route-id="@item.Id" asp-action="SendSms">ارسال پیامک</a>
    <a class="btn btn-danger" asp-route-id="@item.Id" asp-action="Delete">حذف</a>
            </text>
            );

        })
        .Filterable()
        .Sortable()
        .Empty("موردی یافت نشد")
        .Pageable(pager =>
        {
            pager.PageSizes = new Dictionary<Int32, String> { { 0, "All" }, { 5, "5" }, { 10, "10" }, { 15, "15" }, { 20, "20" } };
            pager.ShowPageSizes = true;
            pager.PagesToDisplay = 5;
            pager.CurrentPage = 1;
            pager.RowsPerPage = 2;
        })
        )